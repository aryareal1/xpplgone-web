{
  "name": "xirpl",
  "version": "2.0.0",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "dev": "turbo dev --ui=tui",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo clean",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:pull": "bun run --cwd packages/db db:pull"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/**",
    "packages/**"
  ],
  "overrides": {
    "elysia": "1.4.29"
  },
  "resolutions": {
    "elysia": "1.4.29"
  }
}
