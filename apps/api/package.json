{
  "name": "@xirpl/api",
  "module": "src/index.ts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --outfile server src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@elysia/bearer": "^1.4.4",
    "@elysia/jwt": "^1.4.2",
    "@elysia/openapi": "^1.4.15",
    "@elysia/cors": "^1.4.2",
    "@xirpl/db": "workspace:*",
    "@xirpl/shared": "workspace:*",
    "better-elysia-oauth2": "^1.0.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.29"
  }
}
