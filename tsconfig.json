{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "paths": {
      "@be": ["./apps/api/src"],
      "@be/*": ["./apps/api/src/*"],
      "@fe": ["./apps/web/src"],
      "@fe/*": ["./apps/web/src/*"]
    }
  }
}
